class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        unordered_map<int, int> mp;
        for (int i = 0; i < nums.size(); i++) {
            mp[nums[i]]++;
            if (mp[nums[i]] > 1)
                return true;
        }
        return false;
    }
};
//My approach was using maps but the most optimised solution would be using unordered set
class Solution {
public:
    bool containsDuplicate(vector<int>& nums) {
        unordered_set<int> st;

        for(int i = 0; i < nums.size(); i++) {

            if(st.find(nums[i]) != st.end()) {
                return true;
            }

            st.insert(nums[i]);
        }

        return false;
    }
};//A QUESTION WHICH ARRIVED TO ME WAS WHY USE INSERT-ITS BECAUSE TO STORE AND RECOGNISE ELEMENTS IF THEY APPEAR AGAIN
